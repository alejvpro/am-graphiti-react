# Copy to ignored .env.local only for a separately authorized read-only preview.
VITE_PLAYBACK_MODE=sample
VITE_BASE_PATH=/react-preview/
# Build-time client configuration is visible to anyone loading the bundle.
# Never put a Last.fm shared secret, password, session key or token here.
VITE_LASTFM_USERNAME=
VITE_LASTFM_API_KEY=
VITE_MAC_ROUTE=internal
VITE_MAC_INTERNAL_ORIGIN=
VITE_MAC_EXTERNAL_ORIGIN=
VITE_MAC_LOCAL_ORIGIN=
# Mac song reads only; Last.fm and sample mutations retain their 8-second limits.
VITE_MAC_READ_TIMEOUT_MS=60000
